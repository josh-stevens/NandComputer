class Tetrimino {

  field int type;
  field int rotation;
  field int x;
  field int y;

  constructor Tetrimino new(int pieceType) {
    let type = pieceType;
    let rotation = 0;
    let x = 3;
    let y = 0;

    return this;
  }

  method int getType() {
    return type;
  }

  method int getRotation() {
    return rotation;
  }

  method void moveLeft() {
    let x = x - 1;
    return;
  }

  method void moveRight() {
    let x = x + 1;
    return;
  }

  method void moveDown() {
    let y = y + 1;
    return;
  }

  method void rotate() {
    let rotation = rotation + 1;
    if (rotation = 4) {
      let rotation = 0;
    }
    return;
  }

  method int getBlockXForRotation(int index, int r) {
    // I
    if (type = 0) {
      if ((r = 0) | (r = 2)) {
        return x + index;
      }
      return x + 1;
    }

    // O
    if (type = 1) {
      if ((index = 0) | (index = 2)) {
        return x;
      }
      return x + 1;
    }

    // T
    if (type = 2) {
      if (r = 0) {
        if (index = 0) {
          return x + 1;
        }
        if (index = 1) {
          return x;
        }
        if (index = 2) {
          return x + 1;
        }
        if (index = 3) {
          return x + 2;
        }
      }
      if (r = 1) {
        if ((index = 0) | (index = 1)) {
          return x + 1;
        }
        if (index = 2) {
          return x + 2;
        }
        return x + 1;
      }
      if (r = 2) {
        if (index = 0) {
          return x;
        }
        if (index = 1) {
          return x + 1;
        }
        if (index = 2) {
          return x + 2;
        }
        return x + 1;
      }
      // r = 3
      if ((index = 0) | (index = 3)) {
        return x + 1;
      }
      if (index = 1) {
        return x;
      }
      return x + 1;
    }

    // S
    if (type = 3) {
      if ((r = 0) | (r = 2)) {
        if ((index = 0) | (index = 3)) {
          return x + 1;
        }
        if (index = 1) {
          return x + 2;
        }
        return x;
      }

      // Vertical
      if ((index = 0) | (index = 1)) {
        return x;
      }
      if ((index = 2) | (index = 3)) {
        return x + 1;
      }
    }

    // Z
    if (type = 4) {
      if ((r = 0) | (r = 2)) {
        if (index = 0) {
          return x;
        }
        if ((index = 1) | (index = 2)) {
          return x + 1;
        }
        return x + 2;
      }

      // Vertical
      if ((index = 0) | (index = 1)) {
        return x + 1;
      }
      return x;
    }

    // J
    if (type = 5) {
      if (r = 0) {
        if ((index = 0) | (index = 1)) {
          return x;
        }
        if (index = 2) {
          return x + 1;
        }
        return x + 2;
      }

      if (r = 1) {
        if ((index = 0) | (index = 2) | (index = 3)) {
          return x;
        }
        return x + 1;
      }

      if (r = 2) {
        if (index = 0) {
          return x;
        }
        if (index = 1) {
          return x + 1;
        }
        return x + 2;
      }

      // r = 3
      if ((index = 0) | (index = 1) | (index = 3)) {
        return x + 1;
      }
      return x;
    }

    // L
    if (type = 6) {
      if (r = 0) {
        if (index = 0) {
          return x + 2;
        }
        if (index = 1) {
          return x;
        }
        if (index = 2) {
          return x + 1;
        }
        return x + 2;
      }

      if (r = 1) {
        if (index = 0) {
          return x;
        }
        if ((index = 1) | (index = 2)) {
          return x;
        }
        return x + 1;
      }

      if (r = 2) {
        if (index = 0) {
          return x + 2;
        }
        if (index = 1) {
          return x;
        }
        if (index = 2) {
          return x + 1;
        }
        return x;
      }

      // r = 3
      if (index = 0) {
        return x;
      }
      return x + 1;
    }
    return x;
  }

  method int getBlockX(int index) {
    return getBlockXForRotation(index, rotation);
  }

  method int getBlockYForRotation(int index, int r) {
    // I
    if (type = 0) {
      if ((r = 0) | (r = 2)) {
        return y;
      }
      return y + index;
    }

    // O
    if (type = 1) {
      if ((index = 0) | (index = 1)) {
        return y;
      }
      return y + 1;
    }

    // T
    if (type = 2) {
      if (r = 0) {
        if (index = 0) {
          return y;
        }
        return y + 1;
      }

      if (r = 1) {
        if (index = 0) {
          return y;
        }
        if ((index = 1) | (index = 2)) {
          return y + 1;
        }
        return y + 2;
      }

      if (r = 2) {
        if ((index = 0) | (index = 1) | (index = 2)) {
          return y;
        }
        return y + 1;
      }

      // r = 3
      if (index = 0) {
        return y;
      }
      if ((index = 1) | (index = 2)) {
        return y + 1;
      }
      return y + 2;
    }

      // S
    if (type = 3) {
      if ((r = 0) | (r = 2)) {
        if ((index = 0) | (index = 1)) {
          return y;
        }
        return y + 1;
      }

      if (index = 0) {
        return y;
      }
      if ((index = 1) | (index = 2)) {
        return y + 1;
      }
      return y + 2;
    }


    // Z
    if (type = 4) {
      if ((r = 0) | (r = 2)) {
        if ((index = 0) | (index = 1)) {
          return y;
        }
        return y + 1;
      }

      if (index = 0) {
        return y;
      }
      if ((index = 1) | (index = 2)) {
        return y + 1;
      }
      return y + 2;
    }

    // J
    if (type = 5) {
      if (r = 0) {
        if (index = 0) {
          return y;
        }
        return y + 1;
      }

      if (r = 1) {
        if ((index = 0) | (index = 1)) {
          return y;
        }
        if (index = 2) {
          return y + 1;
        }
        return y + 2;
      }

      if (r = 2) {
        if ((index = 0) | (index = 1) | (index = 2)) {
          return y;
        }
        return y + 1;
      }

      // r = 3
      if (index = 0) {
        return y;
      }
      if (index = 1) {
        return y + 1;
      }
      return y + 2;
    }


    // L
    if (type = 6) {
      if (r = 0) {
        if (index = 0) {
          return y;
        }
        return y + 1;
      }

      if (r = 1) {
        if (index = 0) {
          return y + 2;
        }
        if (index = 1) {
          return y;
        }
        if (index = 2) {
          return y + 1;
        }
        return y + 2;
      }

      if (r = 2) {
        if ((index = 0) | (index = 1) | (index = 2)) {
          return y;
        }
        return y + 1;
      }

      // r = 3
      if ((index = 0) | (index = 1)) {
        return y;
      }
      if (index = 2) {
        return y + 1;
      }
      return y + 2;
    }

    return y;
  }

  method int getBlockY(int index) {
    return getBlockYForRotation(index, rotation);
  }

  method void dispose() {
    do Memory.deAlloc(this);
    return;
  }

}