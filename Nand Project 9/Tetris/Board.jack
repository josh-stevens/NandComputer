class Board {
  field int left;
  field int top;
  field int blockSize;
  field Tetrimino piece;
  field Array cells;

  constructor Board new() {
    var int i;
    let left = 196;
    let top = 8;
    let blockSize = 12;
    let cells = Array.new(200);
    let i = 0;
    while (i < 200) {
      let cells[i] = 0;
      let i = i + 1;
    }
    return this;
  }

  method int screenX(int x) {
    return left + (x * blockSize);
  }

  method int screenY(int y) {
    return top + (y * blockSize);
  }

  method void drawBorder() {
    do Screen.drawLine(
      screenX(0) - 1,
      screenY(0) - 1,
      screenX(10),
      screenY(0) - 1
    );

    do Screen.drawLine(
      screenX(0) - 1,
      screenY(20),
      screenX(10),
      screenY(20)
    );

    do Screen.drawLine(
      screenX(0) - 1,
      screenY(0) - 1,
      screenX(0) - 1,
      screenY(20)
    );

    do Screen.drawLine(
      screenX(10),
      screenY(0) - 1,
      screenX(10),
      screenY(20)
    );

    return;
  }

  method void setPiece(Tetrimino p) {
    let piece = p;
    return;
  }

  method void drawBlock(int x, int y) {
    do Screen.drawRectangle(
      screenX(x),
      screenY(y),
      screenX(x) + 11,
      screenY(y) + 11
    );
    return;
  }

  method void drawPiece() {
    var int i;
    var int x;
    var int y;

    let i = 0;

    while (i < 4) {
      let x = piece.getBlockX(i);
      let y = piece.getBlockY(i);

      do drawBlock(x, y);

      let i = i + 1;
    }

    return;
  }

  method void erasePiece() {
    var int i;
    var int x;
    var int y;

    do Screen.setColor(false);

    let i = 0;

    while (i < 4) {
      let x = piece.getBlockX(i);
      let y = piece.getBlockY(i);

      do drawBlock(x, y);

      let i = i + 1;
    }

    do Screen.setColor(true);
    return;
  }

  method void draw() {
    do drawLockedCells();
    do drawPiece();
    return;
  }

  method boolean canMoveLeft() {
    var int i;
    var int x;
    var int y;

    let i = 0;

    while (i < 4) {
      let x = piece.getBlockX(i);
      let y = piece.getBlockY(i);

      // left border
      if (x = 0) {
        return false;
      }

      // locked cell
      if (cells[(y * 10) + (x - 1)] = 1) {
        return false;
      }

      let i = i + 1;
    }

    return true;
  }

  method boolean canMoveRight() {
    var int i;
    var int x;
    var int y;

    let i = 0;

    while (i < 4) {
      let x = piece.getBlockX(i);
      let y = piece.getBlockY(i);

      // right border
      if (x = 9) {
        return false;
      }

      // locked cell
      if (cells[(y * 10) + (x + 1)] = 1) {
        return false;
      }

      let i = i + 1;
    }

    return true;
  }

  method boolean canMoveDown() {
    var int i;
    var int x;
    var int y;

    let i = 0;

    while (i < 4) {
      let x = piece.getBlockX(i);
      let y = piece.getBlockY(i);
      if (y = 19) {
        return false;
      }

      if (cells[((y + 1) * 10) + x] = 1) {
        return false;
      }

      let i = i + 1;
    }

    return true;
  }

  method boolean canRotate() {
    var int i;
    var int x;
    var int y;
    var int nextRotation;

    let i = 0;

    while (i < 4) {
      let nextRotation = piece.getRotation() + 1;

      if (nextRotation = 4) {
        let nextRotation = 0;
      }
      let x = piece.getBlockXForRotation(i, nextRotation);
      let y = piece.getBlockYForRotation(i, nextRotation);

      // left/right walls
      if (x < 0) {
        return false;
      }

      if (x > 9) {
        return false;
      }

      // Floor
      if (y > 19) {
        return false;
      }

      // Locked cell
      if (~(y < 0)) {
        if (cells[(y * 10) + x] = 1) {
          return false;
        }
      }

      let i = i + 1;
    }

    return true;
  }

  method boolean canPlacePiece() {
    var int i;
    var int x;
    var int y;

    let i = 0;

    while (i < 4) {
      let x = piece.getBlockX(i);
      let y = piece.getBlockY(i);

      if (y < 0) {
        return false;
      }

      if (isOccupied(x, y)) {
        return false;
      }

      let i = i + 1;
    }

    return true;
  }

  method int lockPiece() {
    var int i;
    var int x;
    var int y;
    var int linesCleared;

    let i = 0;

    while (i < 4) {
      let x = piece.getBlockX(i);
      let y = piece.getBlockY(i);

      let cells[(y * 10) + x] = 1;

      let i = i + 1;
    }

    let linesCleared = 0;
    let y = 0;

    while (y < 20) {
      if (isRowFull(y)) {
        let linesCleared = linesCleared + 1;
        do clearRow(y);
      }

      let y = y + 1;
    }

    return linesCleared;
  }

  method boolean isRowFull(int y) {
    var int x;

    let x = 0;

    while (x < 10) {
      if (cells[(y * 10) + x] = 0) {
        return false;
      }

      let x = x + 1;
    }

    return true;
  }

  method boolean isRowEmpty(int y) {
    var int x;

    let x = 0;

    while (x < 10) {
      if (cells[(y * 10) + x] = 1) {
        return false;
      }

      let x = x + 1;
    }

    return true;
  }

  method void clearRow(int y) {
    var int previousRow;
    var int currentRow;
    var int x;
    let previousRow = y - 1;
    let currentRow = y;

    while ((previousRow > 0) | (previousRow = 0)) {
      let x = 0;
      while (x < 10) {
        let cells[(currentRow * 10) + x] =
          cells[(previousRow * 10) + x];

        let x = x + 1;
      }

      let previousRow = previousRow - 1;
      let currentRow = currentRow - 1;
    }

    // clear topmost row
    let x = 0;

    while (x < 10) {
      let cells[x] = 0;
      let x = x + 1;
    }

    return;
  }

  method void drawLockedCells() {
    var int x;
    var int y;

    let y = 0;

    while (y < 20) {
      let x = 0;

      while (x < 10) {
        if (cells[(y * 10) + x] = 1) {
          do drawBlock(x, y);
        } else {
          do Screen.setColor(false);
          do drawBlock(x, y);
          do Screen.setColor(true);
        }

        let x = x + 1;
      }

      let y = y + 1;
    }

    return;
  }

  method boolean isOccupied(int x, int y) {
    if (x < 0) {
      return true;
    }

    if (x > 9) {
      return true;
    }

    if (y > 19) {
      return true;
    }

    if (y < 0) {
      return true;
    }

    return cells[(y * 10) + x] = 1;
  }

  method void reset() {
    var int i;

    let i = 0;
    while (i < 200) {
      let cells[i] = 0;
      let i = i + 1;
    }
    return;
  }
}