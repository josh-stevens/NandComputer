class HUD {
  field int score;
  field int topScore;
  field int lines;
  field int nextType;
  field int level;

  constructor HUD new(int type) {
    let score = 0;
    let lines = 0;
    let nextType = type;
    let level = 1;
    let topScore = 0;

    return this;
  }

  method void addScore(int points) {
    let score = score + (points * level);
    do drawScore();
    return;
  }

  method void drawScore() {
    var int digits;

    let digits = 1;

    if (score > 99) {
      let digits = 3;
    }

    if (score > 999) {
      let digits = 4;
    }

    if (score > 9999) {
      let digits = 5;
    }

    do Output.moveCursor(7, 58 - digits);
    do Output.printInt(score);

    return;
  }

  method void drawTopScore() {
    var int digits;

    let digits = 1;

    if (topScore > 99) {
      let digits = 3;
    }

    if (topScore > 999) {
      let digits = 4;
    }

    if (topScore > 9999) {
      let digits = 5;
    }

    do Output.moveCursor(3, 58 - digits);
    do Output.printInt(topScore);

    return;
  }

  method void addLines(int count) {
    var int oldLevel;

    let lines = lines + count;
    let oldLevel = level;

    let level = 1 + (lines / 10);

    do drawLines();

    if (~(level = oldLevel)) {
      do drawLevel();
    }

    return;
  }

  method void drawLines() {
    var int digits;

    let digits = 1;

    if (lines > 9) {
      let digits = 2;
    }

    if (lines > 99) {
      let digits = 3;
    }

    do Output.moveCursor(11, 56 - digits);
    do Output.printInt(lines);

    return;
  }

  method void drawLevel() {
    var int digits;

    let digits = 1;

    if (level > 9) {
      let digits = 2;
    }

    if (level > 99) {
      let digits = 3;
    }

    do Output.moveCursor(22, 56 - digits);
    do Output.printInt(level);
    return;
  }

  method int getLevel() {
    return level;
  }

  method int getScore() {
    return score;
  }

  method int getTopScore() {
    return topScore;
  }

  method void updateTopScore() {
    let topScore = score;
    do drawTopScore();
    return;
  }

  method void setNext(int type) {
    do erasePreview();
    let nextType = type;
    do drawPreview();
    return;
  }

  method void drawBlock(int x, int y) {
    do Screen.drawRectangle(x, y, x + 11, y + 11);
    return;
  }

  method void drawPreview() {
    if (nextType = 0) {
      // I
      do drawBlock(405, 185);
      do drawBlock(417, 185);
      do drawBlock(429, 185);
      do drawBlock(441, 185);
    }

    if (nextType = 1) {
      // O
      do drawBlock(417, 180);
      do drawBlock(429, 180);
      do drawBlock(417, 192);
      do drawBlock(429, 192);
    }

    if (nextType = 2) {
      // T
      do drawBlock(429, 180);
      do drawBlock(417, 192);
      do drawBlock(429, 192);
      do drawBlock(441, 192);
    }

    if (nextType = 3) {
      // S
      do drawBlock(423, 180);
      do drawBlock(435, 180);
      do drawBlock(411, 192);
      do drawBlock(423, 192);
    }

    if (nextType = 4) {
      // Z
      do drawBlock(411, 180);
      do drawBlock(423, 180);
      do drawBlock(423, 192);
      do drawBlock(435, 192);
    }

    if (nextType = 5) {
      // J
      do drawBlock(411, 180);
      do drawBlock(411, 192);
      do drawBlock(423, 192);
      do drawBlock(435, 192);
    }

    if (nextType = 6) {
      // L
      do drawBlock(435, 180);
      do drawBlock(411, 192);
      do drawBlock(423, 192);
      do drawBlock(435, 192);
    }

    return;
  }

  method void erasePreview() {
    do Screen.setColor(false);
    do Screen.drawRectangle(405, 175, 452, 210);
    do Screen.setColor(true);
    return;
  }

  method void draw() {
    // Top Score
    do Output.moveCursor(1, 50);
    do Output.printString("TOP SCORE");
    do Output.moveCursor(3, 51);
    do Output.printString("0000000");
    do drawTopScore();

    // Score
    do Output.moveCursor(5, 52);
    do Output.printString("SCORE");
    do Output.moveCursor(7, 51);
    do Output.printString("0000000");

    // Lines
    do Output.moveCursor(9, 52);
    do Output.printString("LINES");
    do Output.moveCursor(11, 53);
    do Output.printString("000");

    // Next
    do Output.moveCursor(14, 52);
    do Output.printString("NEXT");
    do drawPreview();

    // Level
    do Output.moveCursor(20, 52);
    do Output.printString("LEVEL");
    do Output.moveCursor(22, 53);
    do Output.printString("001");

    return;
  }

  method void drawGameOver() {
    // Dialog background
    do Screen.setColor(false);
    do Screen.drawRectangle(72, 72, 439, 191);

    do Screen.setColor(true);
    // Black border
    do Screen.setColor(true);
    do Screen.drawLine(72, 72, 439, 72);
    do Screen.drawLine(72, 191, 439, 191);
    do Screen.drawLine(72, 72, 72, 191);
    do Screen.drawLine(439, 72, 439, 191);

    do Output.moveCursor(9, 27);
    do Output.printString("GAME OVER");

    if (score > topScore) {
      do Output.moveCursor(12, 24);
      do Output.printString("NEW HIGH SCORE!");

      do Output.moveCursor(15, 15);
      do Output.printString("PRESS SPACEBAR TO START A NEW GAME");
    } else {
      do Output.moveCursor(12, 15);
      do Output.printString("PRESS SPACEBAR TO START A NEW GAME");
    }

    return;
  }

  method void reset() {
    let score = 0;
    let lines = 0;
    let level = 1;
    return;
  }
}